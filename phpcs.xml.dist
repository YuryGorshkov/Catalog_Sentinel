<?xml version="1.0"?>
<ruleset name="Catalog Sentinel">
    <description>Catalog Sentinel coding standard.</description>
    <file>lib</file>
    <file>tests</file>
    <file>tools</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="180"/>
        </properties>
    </rule>
    <exclude-pattern>install/admin/*</exclude-pattern>
</ruleset>
